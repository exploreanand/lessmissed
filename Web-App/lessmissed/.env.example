# LessMissed web app — environment
# Copy to .env.local and fill in. .env.local is gitignored; never commit it.

# --- MongoDB (required) ------------------------------------------------------
# Use your own database for development. A local mongod is simplest:
#   brew install mongodb-community && brew services start mongodb-community
# Do NOT point this at a shared or production cluster while developing — your
# test sessions, captures and the scripts/ backfills all write to it.
MONGODB_URI=mongodb://127.0.0.1:27017/lessmissed

# --- AWS S3 (required for page previews) -------------------------------------
# Screenshots are rendered by capture-service and uploaded here. The dashboard
# loads them as plain URLs, so the bucket (or a CDN in front of it) must allow
# public reads of the screenshots/ prefix.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name
AWS_S3_BASE_URL=https://your-bucket-name.s3.ap-south-1.amazonaws.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional ----------------------------------------------------------------
# Days to keep raw gaze/click/scroll events before MongoDB expires them.
# EVENTS_TTL_DAYS=90

# Self-hosted image-labelling service (label-service/). Only used by
# scripts/relabel-pages.mjs; everything works without it.
# LM_LABEL_SERVICE_URL=http://127.0.0.1:8077

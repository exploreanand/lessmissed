# Capture service configuration.
# Copy to .env and fill in, or export these in the container's environment.

# THIS FILE IS OPTIONAL.
#
# `npm start` already loads ../Web-App/lessmissed/.env.local, which has every
# required variable. Create a .env here only to override one of them — for
# example to point the worker at a local mongod instead of the shared cluster.
#
# Values here win over the web app's .env.local.

# --- Required (already provided by the web app's .env.local) ----------------
# The worker must use the SAME database the dashboard writes jobs to, or it
# will sit idle while pages stay on "Preparing preview".
# MONGODB_URI=mongodb://127.0.0.1:27017/lessmissed

# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your-bucket
# Used to build the image URL the dashboard loads.
# AWS_S3_BASE_URL=https://your-bucket.s3.ap-south-1.amazonaws.com

# Credentials are read by the AWS SDK's default chain — prefer an instance role
# or a mounted profile over putting long-lived keys here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Tuning (all optional; defaults shown) ----------------------------------
# Concurrent renders. Each is a browser context sharing one Chromium process.
CAPTURE_CONCURRENCY=3

# A lease must outlive the slowest realistic render. Renders heartbeat, so this
# is a ceiling on silence rather than on total runtime.
CAPTURE_LEASE_SECONDS=180
CAPTURE_HEARTBEAT_SECONDS=30

# How often an idle worker checks for new work. This is the latency an admin
# sees between clicking "Add page" and the render starting.
CAPTURE_POLL_INTERVAL_MS=2000

CAPTURE_NAVIGATION_TIMEOUT_MS=45000
CAPTURE_RENDER_TIMEOUT_MS=120000

# Pages taller than this are captured truncated. Both heights are recorded —
# document_height (true) and captured_height (what the image spans) — and
# overlays are always scaled by the latter, so truncation degrades the capture
# rather than silently misplacing every point below the fold.
CAPTURE_MAX_DOCUMENT_HEIGHT_PX=40000

# Below this share of changed non-masked pixels, a render is discarded instead
# of stored. This is the dial that keeps capture volume proportional to change
# rather than to traffic.
CAPTURE_DIFF_THRESHOLD_PCT=1.0

# Re-baseline this often even when nothing looks changed.
CAPTURE_MAX_BASELINE_AGE_DAYS=30

# Versions kept per page and breakpoint, beyond the current one. Versions still
# cited by a region map are never pruned.
CAPTURE_KEEP_VERSIONS=10

CAPTURE_JPEG_QUALITY=88
CAPTURE_THUMB_WIDTH=480

# --- Tests ------------------------------------------------------------------
# Queue tests need a throwaway database. They skip cleanly if this is unset.
# CAPTURE_TEST_MONGO_URI=mongodb://127.0.0.1:27918/lm_queue_test

{
  "manifest_version": 3,
  "name": "LessMissed",
  "version": "1.0.0",
  "description": "Browse brand websites, earn rewards. Powered by real attention data.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LessMissed",
    "default_icon": "icon.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab",
    "tabCapture"
  ],
  "host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["webgazer.js", "contentScript.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["webgazer.js", "icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
